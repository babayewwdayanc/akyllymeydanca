# Скопируйте в .env и заполните: cp .env.example .env
# Случайные пароли и ключи: openssl rand -hex 24

NODE_ENV=production
PORT=3000
# Слушать только локально — снаружи сервер доступен через Nginx
HOST=127.0.0.1
# Сервер стоит за Nginx — брать настоящий IP игрока из заголовков прокси
TRUST_PROXY=1

# База PostgreSQL: postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=postgres://akylly:ПАРОЛЬ_БАЗЫ@127.0.0.1:5432/akylly

# Первый администратор панели (#/admin). Создаётся при первом запуске, если админов ещё нет.
# После входа смените пароль в панели и удалите эти две строки.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ключ для AI-воркера с видеокартой (ai/worker.py). Обязательно, минимум 16 символов.
WORKER_KEY=

# Где хранить фото и видео. Эту папку нужно бэкапить вместе с базой.
DATA_DIR=/opt/akylly/data
# 0 — не создавать демо-поле, демо-матчи и вымышленных игроков
DEMO_MODE=0

# Необязательно: текстовый обзор матча от Claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
