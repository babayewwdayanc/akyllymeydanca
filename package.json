{
  "name": "akylly-meydanca",
  "version": "0.1.0",
  "private": true,
  "description": "Akylly Meýdança — умное футбольное поле: видео матча, клипы, статистика игроков, карточка игрока, AI-анализ",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\" && python3 -I ai/test_events.py",
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/fetch-models.mjs || echo \"Модель фона не скачалась — запустите npm run models\"",
    "admin:create": "node scripts/create-admin.mjs",
    "db:import-sqlite": "node scripts/sqlite-to-postgres.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.31.1",
    "onnxruntime-web": "^1.31.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
